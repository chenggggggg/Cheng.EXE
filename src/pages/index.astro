];

const sectionNavItems = [
  { index: 0, label: "Home", href: "#" },
  { index: 1, label: "Build Fundamentals", href: "#fundamentals" },
  { index: 2, label: "Sharpen Skills", href: "#sharpen-skills" },
  { index: 3, label: "Feel Stronger", href: "#feel-stronger" },
  { index: 4, label: "Experience", href: "#experience" },
  { index: 5, label: "Gallery", href: "#gallery" },
  { index: 6, label: "Contact", href: "#contact" },
];

const siteUrl = "https://chengexe.fit";
const pageTitle = "Cheng.EXE | Muay Thai Personal Training & Coaching";
const pageDescription =
  "Muay Thai personal training, fundamentals coaching, fight skills, and private training with Cheng.EXE.";
const previewImage = `${siteUrl}/media/gallery/20260212-187.jpg`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SportsActivityLocation",
  name: "Cheng.EXE",
  url: siteUrl,
  image: previewImage,
  description: pageDescription,
  sport: "Muay Thai",
  telephone: "+31646281182",
  sameAs: ["https://www.instagram.com/calvin_nakmuay"],
  makesOffer: {
    "@type": "Offer",
    itemOffered: {
      "@type": "Service",
      name: "Muay Thai personal training and coaching",
      serviceType: "Muay Thai personal training",
    },
  },
};
