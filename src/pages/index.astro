      const readMoreHeading = document.querySelector("[data-read-more-heading]");
      const readMoreContent = document.querySelector("[data-read-more-content]");
      const readMoreToggle = document.querySelector("[data-read-more-toggle]");
      const readMoreMain = document.querySelector("[data-read-more-main]");
      const readMoreExpanded = document.querySelector("[data-read-more-expanded]");
      const readMoreSectionNav = readMoreToggle?.closest("[data-panel]")?.querySelector(".section-nav");
      const desktopPanels = window.matchMedia("(min-width: 768px)");
      let activePanelIndex = 0;
      let isPanelLocked = false;
      let isPanelTransitioning = false;
      let isWheelGestureActive = false;
      let panelTransitionTimer = 0;
      let wheelGestureTimer = 0;
      let touchStartX = 0;
      let touchStartY = 0;
      let isGalleryPreviewOpen = false;
      let previewDrag = null;

      const resetGalleryPreviewImage = () => {
        if (!galleryPreviewImage) return;

        galleryPreviewImage.classList.remove("gallery-preview-dragging");
        galleryPreviewImage.style.removeProperty("--preview-x");
        galleryPreviewImage.style.removeProperty("--preview-y");
        galleryPreviewImage.style.removeProperty("--preview-rotate");
      };

      const closeGalleryPreview = () => {
        if (!galleryPreview || !galleryPreviewImage) return;

        galleryPreview.classList.remove("gallery-preview-visible");
        galleryPreview.classList.add("hidden");
        galleryPreview.classList.remove("flex");
        galleryPreviewImage.removeAttribute("src");
        galleryPreviewImage.alt = "";
        resetGalleryPreviewImage();
        previewDrag = null;
        isGalleryPreviewOpen = false;
      };

      galleryItems.forEach((item) => {
        item.addEventListener("click", () => {
          if (!galleryPreview || !galleryPreviewImage) return;

          galleryPreviewImage.src = item.getAttribute("data-gallery-src") ?? "";
          galleryPreviewImage.alt = item.getAttribute("data-gallery-alt") ?? "";
          resetGalleryPreviewImage();
          galleryPreview.classList.remove("hidden");
          galleryPreview.classList.add("flex");
          window.requestAnimationFrame(() => {
            galleryPreview.classList.add("gallery-preview-visible");
          });
          isGalleryPreviewOpen = true;
        });
      });

      galleryClose?.addEventListener("click", closeGalleryPreview);

      galleryPreview?.addEventListener("click", (event) => {
        if (event.target === galleryPreview) closeGalleryPreview();
      });

      galleryPreviewImage?.addEventListener("pointerdown", (event) => {
        if (!isGalleryPreviewOpen || event.button !== 0) return;

        galleryPreviewImage.setPointerCapture(event.pointerId);
        galleryPreviewImage.classList.add("gallery-preview-dragging");
        previewDrag = {
          pointerId: event.pointerId,
          startX: event.clientX,
          startY: event.clientY,
          lastX: event.clientX,
          lastY: event.clientY,
          lastTime: performance.now(),
          velocityX: 0,
          velocityY: 0,
        };
      });

      galleryPreviewImage?.addEventListener("pointermove", (event) => {
        if (!previewDrag || previewDrag.pointerId !== event.pointerId) return;

        event.preventDefault();

        const now = performance.now();
        const deltaTime = Math.max(16, now - previewDrag.lastTime);
        const deltaX = event.clientX - previewDrag.startX;
        const deltaY = event.clientY - previewDrag.startY;

        previewDrag.velocityX = (event.clientX - previewDrag.lastX) / deltaTime;
        previewDrag.velocityY = (event.clientY - previewDrag.lastY) / deltaTime;
        previewDrag.lastX = event.clientX;
        previewDrag.lastY = event.clientY;
        previewDrag.lastTime = now;

        galleryPreviewImage.style.setProperty("--preview-x", `${deltaX.toFixed(1)}px`);
        galleryPreviewImage.style.setProperty("--preview-y", `${deltaY.toFixed(1)}px`);
        galleryPreviewImage.style.setProperty("--preview-rotate", `${(deltaX / 28).toFixed(2)}deg`);
      });

      const finishPreviewDrag = (event) => {
        if (!previewDrag || previewDrag.pointerId !== event.pointerId) return;

        const deltaX = event.clientX - previewDrag.startX;
        const deltaY = event.clientY - previewDrag.startY;
        const throwDistance = Math.hypot(deltaX, deltaY);
        const throwSpeed = Math.hypot(previewDrag.velocityX, previewDrag.velocityY);
        const shouldDismiss = throwDistance > 115 || throwSpeed > 0.75;

        galleryPreviewImage?.classList.remove("gallery-preview-dragging");

        if (shouldDismiss && galleryPreviewImage) {
          const escapeX = deltaX + Math.sign(deltaX || previewDrag.velocityX || 1) * window.innerWidth;
          const escapeY = deltaY + Math.sign(deltaY || previewDrag.velocityY || 1) * window.innerHeight;

          galleryPreviewImage.style.setProperty("--preview-x", `${escapeX.toFixed(1)}px`);
          galleryPreviewImage.style.setProperty("--preview-y", `${escapeY.toFixed(1)}px`);
          galleryPreviewImage.style.setProperty("--preview-rotate", `${(escapeX / 26).toFixed(2)}deg`);
          galleryPreview?.classList.remove("gallery-preview-visible");
          window.setTimeout(closeGalleryPreview, 180);
          previewDrag = null;
          return;
        }

        resetGalleryPreviewImage();
        previewDrag = null;
      };

      galleryPreviewImage?.addEventListener("pointerup", finishPreviewDrag);
      galleryPreviewImage?.addEventListener("pointercancel", finishPreviewDrag);

      const syncGalleryExpandButton = () => {
        if (!gallerySection || !galleryClip || !galleryExpand) return;

        if (isDesktopPanels()) {
          gallerySection.classList.remove("gallery-expanded");
          galleryExpand.setAttribute("aria-expanded", "false");
          galleryExpand.textContent = "View More";
          galleryExpand.hidden = true;
          return;
        }

        galleryExpand.hidden = false;
        window.requestAnimationFrame(() => {
          galleryExpand.hidden = galleryClip.scrollHeight <= galleryClip.clientHeight + 2;
        });
      };

      galleryExpand?.addEventListener("click", () => {
        if (!gallerySection || !galleryExpand) return;

        const isExpanded = gallerySection.classList.toggle("gallery-expanded");
        galleryExpand.setAttribute("aria-expanded", String(isExpanded));
        galleryExpand.textContent = isExpanded ? "View Less" : "View More";
        setMobileScrollReveal();
      });

      readMoreContent?.addEventListener(
        "wheel",
        (event) => {
          const hasExpandedOverflow =
            readMoreExpanded && readMoreExpanded.scrollHeight > readMoreExpanded.clientHeight + 1;

          if (readMoreContent.getAttribute("data-expanded") === "true" && hasExpandedOverflow) {
            event.stopPropagation();
          }
        },
        { passive: true }
      );

      readMoreToggle?.addEventListener("click", () => {
        if (!readMoreContent || !readMoreToggle || !readMoreMain || !readMoreExpanded) return;

        const isExpanded = readMoreContent.getAttribute("data-expanded") === "true";
        const nextExpanded = !isExpanded;
        const shouldReplaceContent = isDesktopPanels();

        readMoreHeading?.setAttribute("data-expanded", String(nextExpanded && shouldReplaceContent));
        readMoreContent.setAttribute("data-expanded", String(nextExpanded));
        readMoreSectionNav?.classList.toggle("section-nav-suppressed", nextExpanded && shouldReplaceContent);
        readMoreToggle.setAttribute("aria-expanded", String(nextExpanded));
        readMoreToggle.textContent = nextExpanded ? "Read Less" : "Read More";
        readMoreMain.setAttribute("aria-hidden", String(nextExpanded && shouldReplaceContent));
        readMoreExpanded.setAttribute("aria-hidden", String(!nextExpanded));

        if (!isDesktopPanels()) {
          setMobileScrollReveal();
        }
      });

      const isDesktopPanels = () => desktopPanels.matches;

      if ("scrollRestoration" in window.history) {
        window.history.scrollRestoration = "manual";
      }

      const resetMobileHorizontalState = () => {
        if (isDesktopPanels()) return;

        if (horizontalTrack) horizontalTrack.style.transform = "";
        window.scrollTo(0, window.scrollY);
      };

      const setPanelReveal = (panel, isVisible) => {
        const heroReveal = panel.querySelector("[data-hero-reveal]");
        const revealBlock = panel.querySelector("[data-chapter-reveal]");
        const revealImage = panel.querySelector("[data-chapter-image]");
        const sectionNav = panel.querySelector(".section-nav");

        heroReveal?.classList.toggle("hero-visible", isVisible);
        revealBlock?.classList.toggle("chapter-visible", isVisible);
        revealImage?.classList.toggle("chapter-image-visible", isVisible);
        sectionNav?.classList.toggle("section-nav-visible", isVisible);
      };

      const getRevealItems = (panel) => {
        const heroReveal = panel.querySelector("[data-hero-reveal]");
        const revealBlock = panel.querySelector("[data-chapter-reveal]");
        const revealImage = panel.querySelector("[data-chapter-image]");

        return [
          ...(heroReveal ? Array.from(heroReveal.querySelectorAll(".hero-nav, .hero-line, .hero-cta")) : []),
          revealImage,
          ...(revealBlock ? Array.from(revealBlock.querySelectorAll(".chapter-line")) : []),
        ].filter(Boolean);
      };

      const getRevealContentRect = (items) => {
        const rects = items.map((item) => item.getBoundingClientRect());

        return rects.reduce(
          (bounds, rect) => ({
            top: Math.min(bounds.top, rect.top),
            bottom: Math.max(bounds.bottom, rect.bottom),
          }),
          {
            top: Number.POSITIVE_INFINITY,
            bottom: Number.NEGATIVE_INFINITY,
          }
        );
      };

      const setMobileScrollReveal = () => {
        if (isDesktopPanels()) return;

        panels.forEach((panel) => {
          const revealBlock = panel.querySelector("[data-chapter-reveal]");
          const revealImage = panel.querySelector("[data-chapter-image]");
          const revealItems = getRevealItems(panel);

          if (revealItems.length === 0) return;

          const viewportHeight = window.innerHeight || 1;
          const contentRect = getRevealContentRect(revealItems);
          const contentTop = contentRect.top;
          const contentBottom = contentRect.bottom;
          const fadeDistance = viewportHeight * 0.5;
          const fadeInStart = viewportHeight * 0.4;
          const fadeOutComplete = viewportHeight * 0.1;
          const fadeInProgress = Math.max(0, Math.min(1, (fadeInStart - contentTop) / fadeDistance));
          const fadeOutProgress = Math.max(0, Math.min(1, (contentBottom - fadeOutComplete) / fadeDistance));
          const scrollElement = document.scrollingElement ?? document.documentElement;
          const maxScroll = Math.max(0, scrollElement.scrollHeight - window.innerHeight);
          const isPageBottom = window.scrollY >= maxScroll - 2;
          const isLastPanel = panel === panels[panels.length - 1];
          const progress = isLastPanel && isPageBottom
            ? 1
            : Math.min(fadeInProgress, fadeOutProgress);
          const easedProgress = progress * progress * (3 - 2 * progress);
          const isEntering = fadeInProgress <= fadeOutProgress;
          const translateY = (1 - easedProgress) * (isEntering ? 28 : -28);

          revealBlock?.classList.add("chapter-visible");
          revealImage?.classList.add("chapter-image-visible");
          panel.querySelector("[data-hero-reveal]")?.classList.add("hero-visible");

          revealItems.forEach((item) => {
            item.style.opacity = easedProgress.toFixed(3);
            item.style.transform = `translate3d(0, ${translateY.toFixed(2)}px, 0)`;
          });
        });
      };

      const clearMobileScrollRevealStyles = () => {
        panels.forEach((panel) => {
          getRevealItems(panel).forEach((item) => {
            item.style.opacity = "";
            item.style.transform = "";
          });
        });
      };

      const revealActivePanel = (index) => {
        panels.forEach((panel, panelIndex) => {
          setPanelReveal(panel, panelIndex === index);
        });

        sectionNavLinks.forEach((link) => {
          const targetIndex = Number(link.getAttribute("data-go-panel"));
          link.classList.toggle("section-nav-link-active", targetIndex === index);
        });
      };

      const mobileRevealObserver = "IntersectionObserver" in window
        ? new IntersectionObserver(
            (entries) => {
              if (isDesktopPanels()) return;

              entries.forEach((entry) => {
                if (entry.isIntersecting) setPanelReveal(entry.target, true);
              });
            },
            { threshold: 0.36 }
          )
        : null;

      panels.forEach((panel) => mobileRevealObserver?.observe(panel));

      const releasePanelLockWhenReady = () => {
        if (!isPanelTransitioning && !isWheelGestureActive) {
          isPanelLocked = false;
        }
      };

      const goToPanel = (index) => {
        if (!horizontalTrack || panels.length === 0) return;

        activePanelIndex = Math.min(Math.max(index, 0), panels.length - 1);
        horizontalTrack.style.transform = isDesktopPanels()
          ? `translate3d(${-activePanelIndex * window.innerWidth}px, 0, 0)`
          : "";
        revealActivePanel(activePanelIndex);
      };

      const getPanelIndexFromHash = () => {
        const currentHash = window.location.hash.replace("#", "");

        if (!currentHash) return 0;

        const hashIndex = panels.findIndex((panel) => panel.id === currentHash);

        return hashIndex >= 0 ? hashIndex : 0;
      };

      const updateSectionHash = (index) => {
        const panel = panels[index];
        const hash = panel?.id ? `#${panel.id}` : window.location.pathname;

        if (window.location.hash === hash) return;

        window.history.pushState(null, "", hash);
      };

      const scrollToMobilePanelContent = (index) => {
        const panel = panels[index];

        if (!panel) return;

        if (panel.id === "contact") {
          window.scrollTo({
            top: document.scrollingElement?.scrollHeight ?? document.body.scrollHeight,
            behavior: "smooth",
          });

          return;
        }

        const image = panel.querySelector("[data-chapter-image]");
        const target = image ?? panel;
        const targetTop = target.getBoundingClientRect().top + window.scrollY;

        window.scrollTo({
          top: targetTop,
          behavior: "smooth",
        });
      };

      const syncToCurrentHash = () => {
        const targetIndex = getPanelIndexFromHash();

        if (isDesktopPanels()) {
          window.scrollTo(0, 0);
          goToPanel(targetIndex);
          return;
        }

        activePanelIndex = targetIndex;
        resetMobileHorizontalState();
        window.requestAnimationFrame(() => {
          if (targetIndex > 0) {
            scrollToMobilePanelContent(targetIndex);
          }

          setMobileScrollReveal();
        });
      };

      const queuePanelMove = (direction) => {
        if (!isDesktopPanels() || isGalleryPreviewOpen || isPanelLocked || direction === 0) return;

        const nextIndex = activePanelIndex + direction;

        if (nextIndex < 0 || nextIndex >= panels.length) return;

        isPanelLocked = true;
        isPanelTransitioning = true;
        window.clearTimeout(panelTransitionTimer);
        goToPanel(nextIndex);
        updateSectionHash(nextIndex);

        panelTransitionTimer = window.setTimeout(() => {
          isPanelTransitioning = false;
          releasePanelLockWhenReady();
        }, 760);
      };

      panelLinks.forEach((link) => {
        link.addEventListener("click", (event) => {
          const targetIndex = Number(link.getAttribute("data-go-panel"));

          if (Number.isNaN(targetIndex)) return;

          event.preventDefault();

          if (!isDesktopPanels()) {
            updateSectionHash(targetIndex);
            scrollToMobilePanelContent(targetIndex);
            return;
          }

          goToPanel(targetIndex);
          updateSectionHash(targetIndex);
        });
      });

      window.addEventListener(
        "wheel",
        (event) => {
          if (!isDesktopPanels()) {
            if (Math.abs(event.deltaX) > Math.abs(event.deltaY)) {
              event.preventDefault();
            }

            return;
          }

          event.preventDefault();

          const dominantDelta = Math.abs(event.deltaY) >= Math.abs(event.deltaX)
            ? event.deltaY
            : event.deltaX;

          if (Math.abs(dominantDelta) < 12) return;

          isWheelGestureActive = true;
          window.clearTimeout(wheelGestureTimer);
          wheelGestureTimer = window.setTimeout(() => {
            isWheelGestureActive = false;
            releasePanelLockWhenReady();
          }, 260);

          queuePanelMove(Math.sign(dominantDelta));
        },
        { passive: false }
      );

      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && isGalleryPreviewOpen) {
          closeGalleryPreview();
          return;
        }

        if (isGalleryPreviewOpen) return;
        if (!isDesktopPanels()) return;

        const nextKeys = ["ArrowDown", "ArrowRight", "PageDown", " "];
        const previousKeys = ["ArrowUp", "ArrowLeft", "PageUp"];

        if (nextKeys.includes(event.key)) {
          event.preventDefault();
          queuePanelMove(1);
        }

        if (previousKeys.includes(event.key)) {
          event.preventDefault();
          queuePanelMove(-1);
        }
      });

      window.addEventListener(
        "touchstart",
        (event) => {
          touchStartX = event.touches[0]?.clientX ?? 0;
          touchStartY = event.touches[0]?.clientY ?? 0;
        },
        { passive: true }
      );

      window.addEventListener(
        "touchmove",
        (event) => {
          if (isDesktopPanels() || event.touches.length === 0) return;

          const deltaX = touchStartX - event.touches[0].clientX;
          const deltaY = touchStartY - event.touches[0].clientY;

          if (Math.abs(deltaX) > Math.abs(deltaY)) {
            event.preventDefault();
          }
        },
        { passive: false }
      );

      window.addEventListener(
        "touchend",
        (event) => {
          if (!isDesktopPanels()) return;

          const touchEndY = event.changedTouches[0]?.clientY ?? touchStartY;
          const deltaY = touchStartY - touchEndY;

          if (Math.abs(deltaY) < 36) return;

          queuePanelMove(Math.sign(deltaY));
        },
        { passive: true }
      );

      window.addEventListener("resize", () => {
        syncGalleryExpandButton();

        if (isDesktopPanels()) {
          clearMobileScrollRevealStyles();
          goToPanel(activePanelIndex);
          return;
        }

        resetMobileHorizontalState();
        setMobileScrollReveal();
      });

      desktopPanels.addEventListener("change", () => {
        isPanelLocked = false;
        isPanelTransitioning = false;
        isWheelGestureActive = false;
        window.clearTimeout(panelTransitionTimer);
        window.clearTimeout(wheelGestureTimer);

        const isReadMoreExpanded = readMoreContent?.getAttribute("data-expanded") === "true";
        readMoreHeading?.setAttribute("data-expanded", String(isReadMoreExpanded && isDesktopPanels()));
        readMoreSectionNav?.classList.toggle("section-nav-suppressed", Boolean(isReadMoreExpanded && isDesktopPanels()));
        readMoreMain?.setAttribute("aria-hidden", String(isReadMoreExpanded && isDesktopPanels()));
        readMoreExpanded?.setAttribute("aria-hidden", String(!isReadMoreExpanded));

        if (isDesktopPanels()) {
          syncGalleryExpandButton();
          clearMobileScrollRevealStyles();
          goToPanel(activePanelIndex);
          return;
        }

        resetMobileHorizontalState();
        syncGalleryExpandButton();
        setMobileScrollReveal();
      });

      window.addEventListener("hashchange", syncToCurrentHash);

      if (isDesktopPanels()) {
        syncGalleryExpandButton();
        clearMobileScrollRevealStyles();
        window.scrollTo(0, 0);
        goToPanel(getPanelIndexFromHash());
      } else {
        resetMobileHorizontalState();
        syncGalleryExpandButton();
        syncToCurrentHash();
      }

      window.addEventListener(
        "scroll",
        () => {
          setMobileScrollReveal();
        },
        { passive: true }
      );

    </script>
  </body>
</html>
